{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": false,
  "permission": "allow",
  "providers": {
    "minimax-openai": {
      "name": "MiniMax OpenAI-compatible (Global)",
      "env": ["MINIMAX_API_KEY"],
      "package": "@opencode/ai/providers/openai-compatible",
      "settings": {
        "baseURL": "https://api.minimax.io/v1"
      },
      "models": {
        "MiniMax-M3.1-Flash": {
          "name": "MiniMax-M3.1-Flash",
          "body": {
            "reasoning_effort": "max"
          },
          "capabilities": {
            "input": ["text", "image", "video"],
            "output": ["text"],
            "reasoning": {
              "supported": true,
              "effort": ["low", "medium", "high", "xhigh", "max"]
            }
          },
          "variants": [
            { "id": "low", "body": { "reasoning_effort": "low" } },
            { "id": "medium", "body": { "reasoning_effort": "medium" } },
            { "id": "high", "body": { "reasoning_effort": "high" } },
            { "id": "xhigh", "body": { "reasoning_effort": "xhigh" } },
            { "id": "max", "body": { "reasoning_effort": "max" } }
          ],
          "cost": {
            "input": 0.15,
            "output": 0.6,
            "cache": { "read": 0.015 }
          },
          "limit": { "context": 1000000 }
        },
        "MiniMax-M3": {
          "name": "MiniMax-M3",
          "capabilities": {
            "input": ["text", "image", "video"],
            "output": ["text"],
            "reasoning": { "supported": true, "toggle": true }
          },
          "variants": [
            { "id": "adaptive", "body": { "thinking": { "type": "adaptive" } } },
            { "id": "disabled", "body": { "thinking": { "type": "disabled" } } },
            { "id": "priority", "body": { "service_tier": "priority" } }
          ],
          "cost": [
            {
              "input": 0.3,
              "output": 1.2,
              "cache": { "read": 0.06 }
            },
            {
              "tier": { "type": "context", "size": 512000 },
              "input": 0.6,
              "output": 2.4,
              "cache": { "read": 0.12 }
            }
          ],
          "limit": { "context": 1000000 }
        }
      }
    },
